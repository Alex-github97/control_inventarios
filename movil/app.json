{
  "expo": {
    "name": "TittanWare",
    "slug": "tittanware-cmms",
    "scheme": "tittanware",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "tech.tittanware.cmms",
      "versionCode": 4,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F5F7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0B0C0E",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-image",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "La cámara se usa para leer el código QR de activos, llantas y repuestos y para tomar fotos de las órdenes de trabajo.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "La galería se usa para adjuntar fotos de las llantas a las inspecciones y las bajas.",
          "cameraPermission": "La cámara se usa para tomar fotos de las llantas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
