# Claude Code — worktrees temporales internos
.claude/worktrees/

# Variables de entorno — nunca subir al repositorio
.env
.env.local
.env.production

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# Alembic (archivos generados en runtime)
alembic/versions/__pycache__/

# Node / Frontend
frontend/node_modules/
frontend/dist/
# Salida de la consola del operador, que se compila aparte.
frontend/dist-admin/
frontend/.vite/
frontend/coverage/

# Uploads de la app
backend/uploads/

# Docker
*.log

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Documentos temporales
*.docx~
~$*.docx

# Despliegue
.env.prod
backups/
deploy/certbot/

# Windows crea este archivo cuando algo redirige a `nul` desde un shell POSIX.
# No es un archivo del proyecto y git ni siquiera lo puede indexar.
nul
backend/nul

# Documentos de trabajo del usuario que viven en la carpeta del proyecto pero
# no son parte de el. Sin esta linea, `git add -A` los arrastra al repositorio.
INTERPRETACI*/
*.pptx
*.xlsx
# Excepción: la calculadora de costos sí es parte del proyecto.
!docs/costos/*.xlsx
