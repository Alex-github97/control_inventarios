# Configuración del servidor. Copiar a .env.prod y completar.
#
#   cp .env.prod.example .env.prod
#
# .env.prod NO se versiona: lleva contraseñas.

# ─── Dominio ──────────────────────────────────────────────────────────────────
DOMINIO=portal.sudominio.com
# Todos los nombres por los que se atiende, separados por espacio. Debe incluir
# a DOMINIO. Si se omite, se atiende solo el principal y los demas nombres
# reciben el certificado equivocado y el navegador los rechaza.
DOMINIOS=portal.sudominio.com www.sudominio.com

# ─── Base de datos ────────────────────────────────────────────────────────────
POSTGRES_DB=plataforma
POSTGRES_USER=plataforma_user
# Genere una nueva; no reutilice la de desarrollo:
#   openssl rand -base64 32
POSTGRES_PASSWORD=CAMBIAR
DATABASE_URL=postgresql+asyncpg://plataforma_user:CAMBIAR@postgres:5432/plataforma

# El pool se comparte entre todos los clientes, porque comparten un Postgres.
# Debe caber en max_connections del servidor: (POOL + OVERFLOW) x workers < 120.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

REDIS_URL=redis://redis:6379/0

# ─── Seguridad ────────────────────────────────────────────────────────────────
# Firma los tokens. Con la clave de ejemplo cualquiera puede fabricar sesiones
# válidas, así que esta línea es obligatoria:
#   openssl rand -hex 32
SECRET_KEY=CAMBIAR
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# El portal y la API salen por el mismo dominio, así que el navegador no ve dos
# orígenes y esta lista queda solo por si algo externo consume la API.
CORS_ORIGINS=["https://portal.sudominio.com","https://www.sudominio.com"]

# ─── Asistente de reuniones del CRM ───────────────────────────────────────────
# Transcribe las reuniones y saca los compromisos. Sin clave, la función queda
# apagada. El audio y el texto de las reuniones salen hacia OpenAI.
OPENAI_API_KEY=
# OPENAI_MODELO_TRANSCRIPCION=gpt-transcribe
# OPENAI_MODELO_VIVO=gpt-live-transcribe
# OPENAI_MODELO_EXTRACCION=gpt-6-astra
# El bot que entra a Meet y Teams (Vexa en su propio servidor, por la red
# privada). Vacío = sin bot. Ver deploy/ASISTENTE_REUNIONES.md.
VEXA_URL=
VEXA_API_KEY=

# ─── Ejecución ────────────────────────────────────────────────────────────────
ENVIRONMENT=production
# En true el motor escribe cada consulta SQL en el log: llena el disco y frena.
DEBUG=false
LOG_LEVEL=INFO
# Regla práctica: 2 por vCPU.
UVICORN_WORKERS=4

# ─── Respaldos ────────────────────────────────────────────────────────────────
DIAS_A_CONSERVAR=14
