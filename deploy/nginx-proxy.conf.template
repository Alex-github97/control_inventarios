# Proxy de entrada: termina el TLS y reparte entre el portal y la API.
#
# Portal y API van por el mismo dominio a propósito: así el navegador no ve dos
# orígenes y no hay CORS que configurar ni que se pueda quedar mal puesto.

# Todo lo que llegue por HTTP se manda a HTTPS, salvo la comprobación de
# Let's Encrypt, que necesita responder en claro para emitir el certificado.
server {
    listen 80;
    # Todos los nombres por los que se llega, separados por espacio. ${DOMINIO}
    # sigue siendo uno solo porque da el nombre de la carpeta del certificado.
    server_name ${DOMINIOS};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    # Todos los nombres por los que se llega, separados por espacio. ${DOMINIO}
    # sigue siendo uno solo porque da el nombre de la carpeta del certificado.
    server_name ${DOMINIOS};

    ssl_certificate     /etc/letsencrypt/live/${DOMINIO}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMINIO}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # El navegador recuerda que este dominio va por HTTPS y no vuelve a
    # intentar en claro.
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Los adjuntos del sistema pueden ser pesados; el límite por defecto de
    # nginx es 1 MB y cortaría las cargas.
    client_max_body_size 25M;

    # nginx resuelve el nombre del backend una sola vez, al cargar la
    # configuración. Al recrear ese contenedor cambia de IP y el proxy sigue
    # apuntando a la vieja: 502 en cada despliegue hasta reiniciarlo a mano.
    # Con el resolver de Docker y la dirección en una variable, la vuelve a
    # resolver.
    resolver 127.0.0.11 valid=30s ipv6=off;

    location /api/ {
        set $destino_api backend:8000;
        proxy_pass http://$destino_api;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # Sin esto el backend cree que todo llega por HTTP y arma mal las URL.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /health {
        set $destino_salud backend:8000;
        proxy_pass http://$destino_salud/health;
    }

    # Todo lo demás es el portal.
    location / {
        set $destino_portal frontend:80;
        proxy_pass http://$destino_portal;
        # El contenedor del frontend reparte entre el portal y la consola del
        # operador según este encabezado, así que tiene que llegar intacto.
        proxy_set_header Host $host;
    }
}
